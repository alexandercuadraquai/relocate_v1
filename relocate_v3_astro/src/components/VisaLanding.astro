---
// Shared template for standalone visa program landing pages (Pensionado, Friendly Nations,
// Qualified Investor, Self-Economic Solvency). Reads its content from the visaN_* keys in
// src/i18n/translations.ts — the same data already used on the homepage's #visa-programs
// section — so there is a single source of truth for visa facts.
import { translations, type Lang } from '../i18n/translations';
import ServiceNav from './ServiceNav.astro';
import ServiceFooter from './ServiceFooter.astro';
import Layout from '../layouts/Layout.astro';

interface Props {
  lang: Lang;
  visaKey: 'visa1' | 'visa2' | 'visa3' | 'visa4';
  slug: string; // e.g. "pensionado-visa" — same slug used in both languages
}

// Same slug used across languages, so the language toggle and related-visa links
// can be computed without a separate translation table.
const VISA_SLUGS: Record<string, string> = {
  visa1: 'pensionado-visa',
  visa2: 'friendly-nations-visa',
  visa3: 'qualified-investor-visa',
  visa4: 'self-economic-solvency-visa'
};

const { lang, visaKey, slug } = Astro.props;
const t = translations[lang] as any;
const home = lang === 'es' ? '/es' : '';
const canonical = `https://relocatepa.com${home}/visas/${slug}`;
const altHref = lang === 'es' ? `/visas/${slug}` : `/es/visas/${slug}`;
const enHref = `https://relocatepa.com/visas/${slug}`;
const esHref = `https://relocatepa.com/es/visas/${slug}`;
const waLink = `https://wa.me/50766743696?text=${t.wa_text}`;

const v = (key: string) => t[`${visaKey}_${key}`];
const name = v('name');
const forWho = v('for');
const requirements = [1, 2, 3, 4, 5].map(i => v(`req${i}`));
const benefits = [1, 2, 3, 4, 5].map(i => v(`ben${i}`));
const faqs = [1, 2, 3].map(i => ({ q: v(`faq${i}_q`), a: v(`faq${i}_a`) }));

const ALL_VISAS = ['visa1', 'visa2', 'visa3', 'visa4'] as const;
const compareRows = ALL_VISAS.map(key => ({
  key,
  name: t[`${key}_name`],
  for: t[`${key}_for`],
  req: t[`${key}_req1`],
  ben: t[`${key}_ben1`],
  current: key === visaKey
}));

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": name,
  "name": `${name} — Panama`,
  "description": v('intro'),
  "provider": { "@id": "https://relocatepa.com/#organization" },
  "areaServed": { "@type": "Country", "name": "Panama" },
  "url": canonical
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": t.svc_breadcrumb_home, "item": `https://relocatepa.com${home || '/'}` },
    { "@type": "ListItem", "position": 2, "name": t.svc_breadcrumb_visas, "item": `https://relocatepa.com${home}/#visa-programs` },
    { "@type": "ListItem", "position": 3, "name": name, "item": canonical }
  ]
};
---

<Layout title={v('page_title')} description={v('page_desc')} lang={lang} canonical={canonical} enHref={enHref} esHref={esHref}>

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <ServiceNav lang={lang} altHref={altHref} />

  <main>
    <section class="service-hero">
      <div class="container">
        <p class="breadcrumb">
          <a href={home || '/'}>{t.svc_breadcrumb_home}</a> ›
          <a href={`${home}/#visa-programs`}>{t.svc_breadcrumb_visas}</a> ›
          <span>{name}</span>
        </p>
        <p class="visa-for" style="text-align: left;">{forWho}</p>
        <h1>{name} <span class="accent">Panama</span></h1>
        <p class="service-intro">{v('intro')}</p>
        <a href={waLink} class="btn btn-primary" target="_blank" rel="noopener">{t.contact_cta}</a>
      </div>
    </section>

    <section class="visa-programs" style="padding-top: 40px;">
      <div class="container">
        <div class="visa-grid" style="grid-template-columns: 1fr 1fr; max-width: 900px; margin: 0 auto;">
          <div class="visa-card">
            <div class="visa-card-header">
              <h3>{t.visa_req_label}</h3>
            </div>
            <div class="visa-card-body">
              <ul class="visa-list">
                {requirements.map(r => <li>{r}</li>)}
              </ul>
            </div>
          </div>
          <div class="visa-card">
            <div class="visa-card-header" style="background: var(--ocean);">
              <h3>{t.visa_ben_label}</h3>
            </div>
            <div class="visa-card-body">
              <ul class="visa-list">
                {benefits.map(b => <li>{b}</li>)}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="why-panama">
      <div class="container">
        <h2 class="section-title">{t.svc_compare_title}</h2>
        <div class="compare-table-wrap">
          <table class="compare-table">
            <thead>
              <tr>
                <th>{t.svc_compare_col_visa}</th>
                <th>{t.svc_compare_col_for}</th>
                <th>{t.svc_compare_col_req}</th>
                <th>{t.svc_compare_col_ben}</th>
              </tr>
            </thead>
            <tbody>
              {compareRows.map(row => (
                <tr class:list={{ current: row.current }}>
                  <td>{row.name}{row.current && ' ★'}</td>
                  <td>{row.for}</td>
                  <td>{row.req}</td>
                  <td>{row.ben}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="how-it-works-section">
      <div class="container">
        <h2 class="section-title">{t.svc_process_title}</h2>
        <div class="steps-grid">
          <div class="step-card">
            <div class="step-number">{t.hiw1_num}</div>
            <h3>{t.hiw1_title}</h3>
            <p>{t.hiw1_desc}</p>
          </div>
          <div class="step-arrow">→</div>
          <div class="step-card">
            <div class="step-number">{t.hiw2_num}</div>
            <h3>{t.hiw2_title}</h3>
            <p>{t.hiw2_desc}</p>
          </div>
          <div class="step-arrow">→</div>
          <div class="step-card">
            <div class="step-number">{t.hiw3_num}</div>
            <h3>{t.hiw3_title}</h3>
            <p>{t.hiw3_desc}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="faq-section">
      <div class="container">
        <h2 class="section-title">{t.svc_faq_title}</h2>
        <div class="faq-list">
          {faqs.map((f, i) => (
            <div class="faq-item">
              <button class="faq-question" id={`svc-faq-q${i}`} aria-expanded="false" aria-controls={`svc-faq-a${i}`}>
                <span>{f.q}</span>
                <span class="faq-icon">+</span>
              </button>
              <div class="faq-answer" id={`svc-faq-a${i}`}>
                <p>{f.a}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="contact-section">
      <div class="container">
        <h2 class="section-title">{t.svc_cta_title}</h2>
        <p class="section-desc">{t.svc_cta_desc}</p>
        <a href={waLink} class="btn btn-primary" target="_blank" rel="noopener">{t.contact_cta}</a>

        <div class="related-visas">
          <h3>{t.svc_related_title}</h3>
          <div class="related-visas-links">
            {ALL_VISAS.filter(k => k !== visaKey).map(k => (
              <a href={`${home}/visas/${VISA_SLUGS[k]}`} class="btn btn-outline">{t[`${k}_name`]}</a>
            ))}
          </div>
          <a href={home || '/'} class="back-home-link">{t.svc_back_home}</a>
        </div>
      </div>
    </section>
  </main>

  <ServiceFooter lang={lang} />
</Layout>
