---
import Layout from '../../../layouts/Layout.astro';
import ServiceNav from '../../../components/ServiceNav.astro';
import ServiceFooter from '../../../components/ServiceFooter.astro';
import { translations } from '../../../i18n/translations';
import { getCollection } from 'astro:content';

const lang = 'es' as const;
const t = translations[lang];
const canonical = 'https://relocatepa.com/es/blog';

const allPosts = await getCollection('blog', ({ data }) => data.lang === 'es');
const posts = allPosts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<Layout title={t.blog_page_title} description={t.blog_page_desc} lang={lang} canonical={canonical} enHref="https://relocatepa.com/blog" esHref={canonical}>

  <ServiceNav lang={lang} altHref="/blog" />

  <main>
    <section class="service-hero">
      <div class="container">
        <p class="breadcrumb"><a href="/es">{t.svc_breadcrumb_home}</a> › <span>{t.nav_blog}</span></p>
        <h1>{t.blog_hero_title}</h1>
      </div>
    </section>

    <section class="visa-programs">
      <div class="container">
        <div class="visa-grid">
          {posts.map(post => (
            <div class="visa-card">
              <div class="visa-card-header">
                <h3>{post.data.title}</h3>
              </div>
              <div class="visa-card-body">
                <p>{post.data.excerpt}</p>
                <a href={`/es/blog/${post.data.slug}`} class="btn btn-outline" style="width: 100%;">{t.blog_read_more}</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <ServiceFooter lang={lang} />
</Layout>
